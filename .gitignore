# InveztIN — one repo, three packages (backend, frontend, mobile).
#
# This file replaces the three separate .gitignores the packages used to carry
# their own copies of. Patterns without a leading slash match at any depth, so
# `node_modules/` covers all three.

# ── dependencies ──
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── SECRETS ───────────────────────────────────────────────────────────────
#
# backend/config/config.env holds the Mongo URI, the JWT secret, the Razorpay
# keys, the Cloudinary keys, the SendGrid key and CRON_SECRET. It must never be
# committed. `config.env.example` documents the shape and IS committed.
.env
.env.*
!.env.example
*.env
!*.env.example
config.env
!config.env.example

# ── build output ──
.next/
out/
build/
dist/
.expo/
.expo-shared/
*.tsbuildinfo
next-env.d.ts

# ── deploy ──
.vercel

# ── test / coverage ──
coverage/

# ── logs ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── editor / OS ──
.DS_Store
Thumbs.db
*.pem
*.swp
.idea/
.vscode/

# ── local agent + scratch files ──
#
# Kept local: these are working notes and machine-specific tool settings, not
# project source.
.claude/
.gemini/
temp.txt

# ── stray documents that landed in the tree ──
*.pdf
migrate-categories.js
